<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/ivCmtAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_circle_gray" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCmtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF2F7BFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 作者头衔：红底白字 -->
            <TextView
                android:id="@+id/tvCmtAuthorBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_author_badge"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:text="作者"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvCmtText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
